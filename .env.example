# Runtime
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# MySQL — isi credential hanya di .env lokal/Hostinger
DATABASE_URL=
DATABASE_HOST=127.0.0.1
DATABASE_PORT=3306
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_NAME=
DATABASE_CONNECTION_LIMIT=5

# Better Auth
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=

# Akun demo lokal untuk prisma/seed.ts (jangan gunakan nilai ini di production)
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_CUSTOMER_EMAIL=
SEED_CUSTOMER_PASSWORD=

# Midtrans Sandbox/Production
MIDTRANS_SERVER_KEY=
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Resend
RESEND_API_KEY=
EMAIL_FROM=

# Protected scheduled jobs
CRON_SECRET=

# One-time production admin bootstrap (disable and remove token after use)
ADMIN_BOOTSTRAP_ENABLED=false
ADMIN_BOOTSTRAP_TOKEN=

# Optional monitoring
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
